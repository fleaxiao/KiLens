{
	"name": "kilens",
	"displayName": "KiLens",
	"description": "KiCAD Viewer for Visual Studio Code",
	"version": "0.0.1",
	"publisher": "fleaxiao",
	"private": true,
	"license": "MIT",
	"icon": "icon.png",
	"repository": "https://github.com/fleaxiao/KiLens",
	"engines": {
		"vscode": "^1.74.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onCustomEditor:kilens.preview",
		"onCommand:kilens.refresh"
	],
	"browser": "./dist/web/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "kilens.refresh",
				"title": "Refresh Preview",
				"icon": "$(refresh)"
			}
		],
		"customEditors": [
			{
				"viewType": "kilens.preview",
				"displayName": "KiCAD Viewer",
				"selector": [
					{
						"filenamePattern": "*.kicad_pcb"
					},
					{
						"filenamePattern": "*.kicad_sch"
					}
				]
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "kilens.refresh",
					"when": "activeCustomEditorId == kilens.preview",
					"group": "navigation"
				}
			]
		}
	},
	"scripts": {
		"test": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. --extensionTestsPath=dist/web/test/suite/index.js",
		"pretest": "npm run compile-web",
		"vscode:prepublish": "npm run package-web",
		"compile-web": "webpack",
		"watch-web": "webpack --watch",
		"package-web": "webpack --mode production --devtool hidden-source-map",
		"lint": "eslint"
	},
	"files": [
		"dist",
		"media",
		"icon.png"
	],
	"devDependencies": {
		"@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/mocha": "^9.0.0",
		"@types/vscode": "^1.73.0",
		"@types/webpack-env": "^1.16.2",
		"@vscode/test-web": "^0.0.22",
		"assert": "^2.0.0",
		"eslint": "^9.13.0",
		"mocha": "^9.2.0",
		"path-browserify": "^1.0.1",
		"process": "^0.11.10",
		"ts-loader": "^9.2.5",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.16.0",
		"webpack": "^5.52.1",
		"webpack-cli": "^4.8.0"
	},
	"__metadata": {
		"installedTimestamp": 1781781356749,
		"targetPlatform": "undefined",
		"size": 2751536
	}
}
